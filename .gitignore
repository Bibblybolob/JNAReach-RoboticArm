# Colcon build artifacts
build/
install/
log/

# Vendored librealsense source tree. Cloned here to build pyrealsense2 on
# ARM64, where Intel ships no wheel. 827MB of someone else's history has no
# business in this repo's -- and it sits directly in the path of the `git add
# -A` this project commits with, so it is ignored rather than merely
# uncommitted. See the README for what to do with it.
librealsense/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
.eggs/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# ROS bags
*.bag
*.db3

# Cursor
.cursor/

# SSH keypair used to reach the VM — must never be committed
bob
bob.pub
*.pem
id_rsa*

# Inference build artifacts. A TensorRT engine is compiled for one exact GPU,
# driver and TensorRT version and is invalid anywhere else — including this
# same board after a JetPack upgrade. Rebuild from the .pt with
#     yolo export model=elevator_buttons.pt format=engine imgsz=640 half=True
# (~10min, and export via Ultralytics rather than trtexec or the engine
# carries no class names and the detection bridge sees class0..classN).
*.engine
*.onnx

# Training output. Checkpoints, plots and per-epoch CSVs — reproducible from
# the dataset and the training script, and large.
runs/
runs_960/
runs_panel/

# Pretrained checkpoints pulled from the Ultralytics release assets by
# benchmarking and by the AMP check at the start of training. Re-downloaded on
# demand. elevator_buttons.pt is OURS and stays tracked — it is the source of
# truth every engine is built from.
yolo11*.pt
yolo26*.pt
yolov8*.pt

# CLIP weights, fetched on demand by YOLO-World (338MB)
weights/

# Training runs and exported engines: gigabytes, and an engine is built
# for one board and does not travel (see scripts/export_button_engine.py).
runs_buttons/
*.engine
