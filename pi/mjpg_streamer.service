[Unit]
Description=MJPEG Camera Stream for myCobot 280 Pi
After=network-online.target
Wants=network-online.target
# See mycobot_server.service: the default start rate limit is easy to exhaust
# at boot, and once it is, systemd stops trying permanently.
StartLimitIntervalSec=0

[Service]
Type=simple
User=er
# Explicit rather than implied, so redeploying never silently changes the
# rate. Raised 15 -> 30 once camera_stream.py stopped running a capture loop
# per client: the old path read and JPEG-encoded once per connected client
# per frame, which is what left the Pi with no headroom.
#
# Detection rate is the servo's real ceiling -- simulated, 5/s to 15/s nearly
# halved the tracking error on a waved hand -- so this is the cheapest
# remaining gain in the whole pipeline. It is also the setting most likely to
# be too optimistic for the hardware: watch the server's own
# `streaming N FPS (K KB/frame), C client(s)` line and back off if N is well
# under 30. Lower --quality before lowering --fps; smaller frames degrade
# tracking more gracefully than staler ones.
ExecStart=/usr/bin/python3 /home/er/JON/mycobot_project/pi/camera_stream.py --port 8080 --device 0 --width 640 --height 480 --fps 30
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
