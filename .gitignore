# Colcon build artifacts
build/
install/
log/

# Vendored librealsense source tree. Cloned here to build pyrealsense2 on
# ARM64, where Intel ships no wheel. 827MB of someone else's history has no
# business in this repo's -- and it sits directly in the path of the `git add
# -A` this project commits with, so it is ignored rather than merely
# uncommitted. See the README for what to do with it.
librealsense/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
.eggs/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# ROS bags
*.bag
*.db3

# Cursor
.cursor/

# SSH keypair used to reach the VM — must never be committed
bob
bob.pub
*.pem
id_rsa*

# Button-detector training: venv, downloaded Roboflow dataset, and run
# checkpoints. Reproducible from scripts/train_button_detector.py; none of
# it belongs in history. elevator_buttons.pt itself is also excluded here
# for now — see README for how to obtain or place a trained model.
.venv-train/
entc-elevator-button-detection-*/
runs/
elevator_buttons.pt
